<?xml version="1.0" ?>
<!--
  iris_with_camera/model.sdf
  Based on the ArduPilot iris model.
  Additions:
    • A forward-facing camera sensor on the base_link
    • gazebo_ros_camera plugin publishing to /camera/image_raw
  The ArduPilot SITL plugin (libArduPilotPlugin.so) handles flight dynamics
  and communicates with sim_vehicle.py over UDP.
-->
<sdf version="1.6">
  <model name="iris_with_camera">
    <pose>0 0 0.194923 0 0 0</pose>

    <!-- ══════════════════════════════════════════════════════════════
         AIRFRAME
    ══════════════════════════════════════════════════════════════ -->
    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.029125</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.029125</iyy><iyz>0</iyz>
          <izz>0.055225</izz>
        </inertia>
      </inertial>

      <!-- Fuselage -->
      <visual name="iris_visual">
        <geometry>
          <mesh>
            <uri>model://iris/meshes/iris.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="iris_collision">
        <geometry>
          <box><size>0.47 0.47 0.11</size></box>
        </geometry>
      </collision>

      <!-- ── Camera sensor (forward-facing, mounted under nose) ──── -->
      <sensor name="front_camera" type="camera">
      <pose>0.1 0 -0.05 0 0 0</pose>
      <topic>front_camera</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>  <!-- ~80 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
        <optical_frame_id>camera_link_optical</optical_frame_id>
      </camera>
    </sensor>
    </link>

    <!-- ══════════════════════════════════════════════════════════════
         ROTORS  (motor_0 = front-right CW, motor_1 = back-left CW,
                  motor_2 = front-left CCW, motor_3 = back-right CCW)
    ══════════════════════════════════════════════════════════════ -->

    <!-- motor_0: front right -->
    <link name="rotor_0">
      <pose>0.13 -0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
                  <iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <geometry>
          <mesh><uri>model://iris/meshes/iris_prop_ccw.dae</uri></mesh>
        </geometry>
        <material><script><n>Gazebo/Blue</n></script></material>
      </visual>
      <collision name="rotor_0_collision">
        <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent><child>rotor_0</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- motor_1: back left -->
    <link name="rotor_1">
      <pose>-0.13 0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
                  <iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <geometry>
          <mesh><uri>model://iris/meshes/iris_prop_ccw.dae</uri></mesh>
        </geometry>
        <material><script><n>Gazebo/DarkGrey</n></script></material>
      </visual>
      <collision name="rotor_1_collision">
        <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent><child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- motor_2: front left -->
    <link name="rotor_2">
      <pose>0.13 0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
                  <iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <geometry>
          <mesh><uri>model://iris/meshes/iris_prop_cw.dae</uri></mesh>
        </geometry>
        <material><script><n>Gazebo/Blue</n></script></material>
      </visual>
      <collision name="rotor_2_collision">
        <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent><child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- motor_3: back right -->
    <link name="rotor_3">
      <pose>-0.13 -0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
                  <iyy>0.000166704</iyy><iyz>0</iyz><izz>0.000167604</izz></inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <geometry>
          <mesh><uri>model://iris/meshes/iris_prop_cw.dae</uri></mesh>
        </geometry>
        <material><script><n>Gazebo/DarkGrey</n></script></material>
      </visual>
      <collision name="rotor_3_collision">
        <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent><child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ══════════════════════════════════════════════════════════════
         ARDUPILOT PLUGIN
         Communicates with sim_vehicle.py over UDP.
         fdm_addr / fdm_port_in must match SITL's --sim-address flags.
    ══════════════════════════════════════════════════════════════ -->
    <plugin name="ardupilot_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <modelXYZToNED>0 0 0 3.141593 0 0</modelXYZToNED>

      <!-- Motor mapping: channel → joint, direction, max RPM -->
      <control channel="0">
        <jointName>rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min><servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
      </control>
      <control channel="1">
        <jointName>rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min><servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
      </control>
      <control channel="2">
        <jointName>rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min><servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
      </control>
      <control channel="3">
        <jointName>rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min><servo_max>2000</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min><cmd_max>2.5</cmd_max><cmd_min>-2.5</cmd_min>
      </control>
    </plugin>

  </model>
</sdf>
