material FaceTexture
{
  technique
  {
    pass
    {
      lighting on
      ambient 1 1 1 1
      diffuse 1 1 1 1
      specular 0.1 0.1 0.1 1
      
      texture_unit
      {
        texture stock_face.jpg
        filtering anisotropic
        max_anisotropy 16
      }
    }
  }
}